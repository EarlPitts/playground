cabal-version: 3.12
name:          hlox
version:       0.1.0.0
license:       GPL-3.0-only
license-file:  LICENSE
author:        ben
build-type:    Simple

common warnings
  ghc-options: -Wall -Wno-unused-do-bind 

library
  import:           warnings
  exposed-modules:  Hlox
  build-depends:
    , base
    , parsec
    , text

  hs-source-dirs:   src
  default-language: Haskell2010

executable hlox
  import:           warnings
  ghc-options:      -O1 -threaded -rtsopts -with-rtsopts=-N
  main-is:          Main.hs
  build-depends:
    , base
    , hlox

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite hlox-test
  import:           warnings
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , hlox
